202512/cf4d096d6aefda267dc79ca014f5f0f51767077492116302221082","flag_adult":0,"flag_complete":0,"count_epi":672,"count_view":581444,"count_like":1920,"count_good":1116,"new_epi_num":671,"new_epi_open_dt":"2026-06-05 11:00:14","novel_open_dt":"2025-05-07 01:44:00","flag_live":0,"flag_detail_trans":2,"detail_trans_dt":"2025-08-21 07:00:00","novel_tag_list":["Past Lives","European Ambience","Slice of Life","Academy","Character Growth"],"additional_data":{},"cover_img":""}]},{"sort":{"title":"Premium Originals","sort_no":750,"flag_type":0,"flag_type_str":"horizontal2","flag_content":1},"conf":{"idx":39,"view_more_link":"/novels?is_indie_to_premium=1","flag_curation_sort":1,"sid":"main_originals","thumbnail":"","m_thumbnail":"","sort_no":750},"curation":[{"idx":172410,"main_group":39,"sort_no":17,"p_sort_no":0,"subtitle":[],"description":[],"link_url":"/novel/4702","novel_no":4702,"flag_cate":1,"flag_content":1,"content_type":2,"novel_name":"Tales Of The Three Skies","writer_name":"FriedGalacticChicken","novel_story":"In the continent of Aezeir, destruction reigned. Demons, angels, and demi-humans slaughtered humanity at the command of the evil gods. What began as divine judgment became an endless war that devoured the world itself.\n\nWhen the gods turned upon one another, the heavens shattered. The six who defended mankind were slain, and the remaining evil gods, consumed by hatred, allied with the Demon God to cleanse the world of humans. For a thousand years, blood and despair stained the lands.\n\n\nAs the World Tree burned and the last light of humanity began to fade, the continent itself wept. From the dying earth, three souls were born, a final miracle of the world’s will, destined to rise when all else was lost.\n\n\nTheir birth marked the end of the Age of Despair and the beginning of the Era of Dawn.\nWhen light once again dared to challenge the darkness,\nand the fate of Aezeir would be rewritten.","novel_img":"https://gn.novelpia.com/upload/novel/4702/69a60707c671e73e68fd432473ae9f0117763997050281798606992","flag_adult":0,"flag_complete":0,"count_epi":57,"count_view":1185,"count_like":69,"count_good":10,"new_epi_num":56,"new_epi_open_dt":"2026-06-08 00:00:00","novel_open_dt":"2026-04-17 04:32:58","flag_live":0,"flag_detail_trans":0,"detail_trans_dt":null,"novel_tag_list":["Light Novel","Character Growth","Comedy","Adventure","Action","Drama","Female Protagonist","Saintess","Salvation"],"additional_data":{},"cover_img":""},{"idx":172380,"main_group":39,"sort_no":14,"p_sort_no":0,"subtitle":[],"description":[],"link_url":"/novel/3430","novel_no":3430,"flag_cate":12,"flag_content":1,"content_type":2,"novel_name":"Dryads of the Radioactive World","writer_name":"Blackhole32","novel_story":"A tree falls from the sky at mach 12.9. A family of five and a pet cat, along with several neighboring households, disintegrate in a vivid explosion.\n\nThe incident snowballs into a major global conflict that develops into a nuclear apocalypse and ends the modern era.\n\nCenturies later, the tree emerges from the ashes of nuclear war with a confused foreign will inside.\n\n\"Wait, why am I a tree? And why is the ground so spicy?\"\n\nA radioactive spirit is born on the tomb world that is Earth.\n\n\nCover — © 2025 Blackhole32 (Xeroth Ernassal)","novel_img":"https://gn.novelpia.com/upload/novel/3430/e04ae3604efec43a2067f43c29159c2517667451163982965471278","flag_adult":0,"flag_complete":0,"count_epi":44,"count_view":19960,"count_like":628,"count_good":247,"new_epi_num":44,"new_epi_open_dt":"2026-05-31 12:57:28","novel_open_dt":"2025-12-05 12:37:16","flag_live":0,"flag_detail_trans":0,"detail_trans_dt":null,"novel_tag_list":["Gender Bender","Character Growth","Apocalypse"],"additional_data":{},"cover_img":""},{"idx":172374,"main_group":39,"sort_no":8,"p_sort_no":0,"subtitle":[],"description":[],"link_url":"/novel/3843","novel_no":3843,"flag_cate":1,"flag_content":1,"content_type":2,"novel_name":"Beyond the Abyssline","writer_name":"FriedGalacticChicken","novel_story":"Mixarnt, once a Timekeeper tasked with mending timelines and preventing world collapses, is killed by anomalies and unexpectedly reincarnated as an abandoned infant in a vast and unfamiliar realm. This world is composed of 3,000 continents, filled with diverse civilizations, ancient secrets, and advancing technologies.\n\nFound and raised by the elves, Mixarnt grows under the watchful eye of Fantasia and the wisdom of the World Tree, which senses his extraordinary fate. When anomalies threaten the balance of time once again, the World Tree grants Mixarnt a spirit weapon, revealing that his true destiny lies beyond the Abyss Line, a dark, towering boundary that separates his continent from 1,500 others, home to powerful monsters, enigmatic warriors, and untold dangers.\n\nWith his past as a timekeeper sealed and an uncertain future ahead, Mixarnt embarks on a perilous journey across the world. As he traverses continents, battles formidable foes, and uncovers hidden truth.","novel_img":"https://gn.novelpia.com/upload/novel/3843/5d3614a75bd93e2b742bc0577a2321a417688054030011826782416","flag_adult":0,"flag_complete":0,"count_epi":311,"count_view":11684,"count_like":393,"count_good":22,"new_epi_num":311,"new_epi_open_dt":"2026-06-07 01:41:08","novel_open_dt":"2026-01-20 00:00:00","flag_live":0,"flag_detail_trans":0,"detail_trans_dt":null,"novel_tag_list":["Reincarnation","Adventure","Romantic Comedy","Magic","Elf","Harem","Light Novel","Academy"],"additional_data":{},"cover_img":""},{"idx":172378,"main_group":39,"sort_no":12,"p_sort_no":0,"subtitle":[],"description":[],"link_url":"/novel/3609","novel_no":3609,"flag_cate":1,"flag_content":1,"content_type":2,"novel_name":"Everyones Affection Is Negative So I’ll Just Survive\n\n\n","writer_name":"Louiscasper","novel_story":"I wasn’t a hero.\nI grew up in an orphanage where strength decided who ate, beauty decided who was protected, and the weak learned only one rule survive. I never believed in selflessness, yet in the end, I died saving children from a burning orphanage without understanding why I chose to act.\nWhen I opened my eyes again, I wasn’t reborn as a protagonist.\nI became Louis Casper, a minor villain in a novel . A noble’s third son. A disposable character destined to die during the academy attack arc—crushed to death by the body of an enemy defeated by the real protagonist.\nThis time, however, I can see something the novel never mentioned.\nNumbers.\nAn Affection System that reveals how others truly feel about me. My mother’s affection is -59. Servants, teachers, classmates—almost all negative.\nMy stats are pathetic. My luck is worse.\n","novel_img":"https://gn.novelpia.com/upload/novel/3609/bc4ed911fb98c127a21f430c079d9cb317766130073822776479542","flag_adult":0,"flag_complete":0,"count_epi":46,"count_view":49124,"count_like":1036,"count_good":615,"new_epi_num":46,"new_epi_open_dt":"2026-04-26 15:44:07","novel_open_dt":"2025-12-25 06:19:12","flag_live":0,"flag_detail_trans":0,"detail_trans_dt":null,"novel_tag_list":["Academy","Misunderstandings","Character Growth","European Ambience","Comedy","Reincarnation","Isekai","Game System","Weak Protagonist"],"additional_data":{},"cover_img":""},{"idx":172369,"main_group":39,"sort_no":3,"p_sort_no":0,"subtitle":[],"description":[],"link_url":"/novel/3996","novel_no":3996,"flag_cate":6,"flag_content":1,"content_type":2,"novel_name":"After the Breakup, She Dragged Me Into Her Obsession","writer_name":"NightOracle","novel_story":"Even after ending things with the childhood sweetheart who had stayed by his side for years, he never realized that someone else had already been watching him from the dark for a very long time.\n\nHe was too slow to notice the eyes fixed on him, and far too naïve to understand that once the shadows finally closed around him and the tide pulled him under, there would be no way left to climb back out.\n\nHe used to think that calling her sister would keep a line between them, that as long as he stayed on his side of it, nothing would ever truly change. He did not know that, to her, that line had already disappeared.\n\n[Cover Character: Evelyn Miller]","novel_img":"https://gn.novelpia.com/upload/novel/3996/571f001a2c506659266ee32f65ea228517803289517721056353678","flag_adult":0,"flag_complete":0,"count_epi":130,"count_view":32683,"count_like":579,"count_good":133,"new_epi_num":129,"new_epi_open_dt":"2026-06-08 00:00:00","novel_open_dt":"2026-02-03 06:00:43","flag_live":0,"flag_detail_trans":0,"detail_trans_dt":null,"novel_tag_list":["Yandere","Angst","Light Novel","Obsession","Slice of Life","Age Gap","Sister","Modern","Single Female Lead"],"additional_data":{},"cover_img":""},{"idx":172370,"main_group":39,"sort_no":4,"p_sort_no":0,"subtitle":[],"description":[],"link_url":"/novel/3700","novel_no":3700,"flag_cate":6,"flag_content":1,"content_type":2,"novel_name":"After the Rainy Night, I Was Caught in the Underworld Queen’s Embrace","writer_name":"NightOracle","novel_story":"Chase Ford was born into wealth and status, the golden son of a powerful family. But at nineteen, everything fell apart. In a single year, he became a disgraced heir with nothing left to his name. Cold, proud, and graceful, he valued his dignity more than his own life.\n\nBy chance, he was forced to save a woman steeped in blood and violence, someone whose reputation alone struck fear across the criminal world. Her name was Wren Mercer, a woman people whispered about like a curse.\n\nShe did not understand love. She was only capable of taking.\n\nHe pushed forward through the mud, enduring everything in silence, while she lost herself in the thrill of training him into her dog.\n\nShe treated him like something wild to be broken.\nHe swallowed humiliation and waited, growing sharper and stronger, until his wings were finally strong enough for him to tear apart the fragile illusion of balance between them with his own hands.\n\nOnly then did Wren wake up. There had never been submission. Not once.","novel_img":"https://gn.novelpia.com/upload/novel/3700/967650a24610ec86e098bbbc7e176d461778089403267893874635","flag_adult":0,"flag_complete":1,"count_epi":125,"count_view":46161,"count_like":520,"count_good":133,"new_epi_num":125,"new_epi_open_dt":"2026-05-31 00:00:00","novel_open_dt":"2026-01-04 03:20:56","flag_live":0,"flag_detail_trans":0,"detail_trans_dt":null,"novel_tag_list":["Yandere","Angst","Toxic Female Lead","Stockholm syndrome","Slice of Life","Age Gap","Modern","Male Protagonist"],"additional_data":{},"cover_img":""},{"idx":172372,"main_group":39,"sort_no":6,"p_sort_no":0,"subtitle":[],"description":[],"link_url":"/novel/4325","novel_no":4325,"flag_cate":1,"flag_content":1,"content_type":2,"novel_name":"New World Mimic","writer_name":"CainShax","novel_story":"Isekai comes in many forms. In my case, the story is different from the usual one. I returned from another world, retaining certain magical abilities—or perhaps system skills—after spending only a few days in a coma in my own world… while far more time had passed in the other one. And now I’m back in my former body, the body of someone who has been through a lot, yet still… achieved his goal. Now I can finally live a normal life again. All that’s left is to find her—she came back with me too—and then we’ll finally be able to…\nAttention! A System has descended upon your world! Fight or die! Location update error! Please wait…\nGods damn it…\n","novel_img":"https://gn.novelpia.com/upload/novel/4325/333c7befcc5f17f9a0f098c0a80e5a6517730679256694802998359","flag_adult":0,"flag_complete":0,"count_epi":35,"count_view":719,"count_like":39,"count_good":0,"new_epi_num":34,"new_epi_open_dt":"2026-05-29 12:28:12","novel_open_dt":"2026-03-09 14:58:25","flag_live":0,"flag_detail_trans":0,"detail_trans_dt":null,"novel_tag_list":["Apocalypse","Game System","Survival","Monsters","Overpowered","Male Lead","Dark Fantasy","Post-Apocalypse","Supernatural Powers"],"additional_data":{},"cover_img":""},{"idx":172379,"main_group":39,"sort_no":13,"p_sort_no":0,"subtitle":[],"description":[],"link_url":"/novel/3471","novel_no":3471,"flag_cate":12,"flag_content":1,"content_type":2,"novel_name":"The Flesh Bender Attend The Academy","writer_name":"EliteToeCollector","novel_story":"I woke up in the body of Clyde Redmane. An orphan, broke, bullied kid living in a monster-ridden world of heroes and superpowers. But instead of awakening to some flashy ability like fire, lightning, or strength, I inherited Clyde’s terrifying gift. The power to twist, sculpt, and weaponize my own flesh and bone. \n\nA grotesque ability everyone fears… yet it’s the only thing I have as I step into Avaraine Heroic Academy, a place where heroes are forged to fight against monsters beyond humanity's wall, and where one wrong move can get me expelled—or killed.\n\n----\nPlease forgive me for any grammar mistake as English is not my main language. (Any criticism is always welcomed!) \n\n*trigger warning*\nThere is grotesque element which is basically the main core of the story, I'm sure I am pretty bad at describing it but still trigger warning.","novel_img":"https://gn.novelpia.com/upload/novel/3471/42af11e144e7479a2ea526a812ff226f17688202868524671422786","flag_adult":0,"flag_complete":0,"count_epi":93,"count_view":26782,"count_like":481,"count_good":208,"new_epi_num":92,"new_epi_open_dt":"2026-06-06 12:31:04","novel_open_dt":"2025-12-09 09:44:00","flag_live":0,"flag_detail_trans":0,"detail_trans_dt":"0000-00-00 00:00:00","novel_tag_list":["Misunderstandings","Hero","Villain","Supernatural Powers","Academy","Monsters"],"additional_data":{},"cover_img":""},{"idx":172377,"main_group":39,"sort_no":11,"p_sort_no":0,"subtitle":[],"description":[],"link_url":"/novel/3424","novel_no":3424,"flag_cate":12,"flag_content":1,"content_type":2,"novel_name":"The Cardinal Sky","writer_name":"GenderbendAddict","novel_story":"The world has ended, apparently.\n\nI sat down on an overgrown patch of grass, contemplating about things.\n\nSoft and fair skin, a frail figure that could snap, lustrous long hair... and a fairly modest chest.\n\nAh, is it that troupe? Where I turned into a girl. Surprising, that's for sure.\n\n...But, does it have to be in a world like this?\n\n[Cover was made by a cool person, a friend]","novel_img":"https://gn.novelpia.com/upload/novel/3424/310b0e696fb6fe87066b4c2acea1e5dc17733903053623078205780","flag_adult":0,"flag_complete":0,"count_epi":108,"count_view":18732,"count_like":380,"count_good":179,"new_epi_num":107,"new_epi_open_dt":"2026-05-30 12:57:22","novel_open_dt":"2025-12-05 07:22:59","flag_live":0,"flag_detail_trans":0,"detail_trans_dt":null,"novel_tag_list":["Gender Bender","Unreliable Narrator","Transmigration","Character Growth","Action","Magic","Supernatural Powers","Lovecraftian"],"additional_data":{},"cover_img":""},{"idx":172371,"main_group":39,"sort_no":5,"p_sort_no":0,"subtitle":[],"description":[],"link_url":"/novel/3387","novel_no":3387,"flag_cate":1,"flag_content":1,"content_type":2,"novel_name":"Guess I'm a World Builder Now?","writer_name":"Amalgam","novel_story":"I was just a colony-sim gamer minding my own business… until a goddess pulled me into her budding world.\n\n\"Honorable one. He who has governed over a thousand worlds and brought each prosperity and chaos in equal measure. I humbly request your assistance in the nurturing of a budding star. To aid the growth of civilization and create a utopia.\"\n\nShe wants me to help grow her burgeoning magical world. But it seems she mistook me for a fellow god.\n\n\"Lord Yvell, I've long admired your work! I beseech you! Please, provide me with your wisdom!\"\n\nFuck it. I'm unemployed and have nothing to lose, anyway. This'll be a fun time-waster.\n\n-\n\nCover generated by Seaart.ai (RIN Flat Flani Illustrious) + a few edits thrown in by me.","novel_img":"https://gn.novelpia.com/upload/novel/3387/fe5831a2745f92b2e4e68a886944d8ce17680766731154110021941","flag_adult":0,"flag_complete":0,"count_epi":105,"count_view":20588,"count_like":620,"count_good":129,"new_epi_num":104,"new_epi_open_dt":"2026-06-06 21:38:06","novel_open_dt":"2025-12-03 15:43:12","flag_live":0,"flag_detail_trans":0,"detail_trans_dt":null,"novel_tag_list":["Isekai","Constellation","Comedy","Misunderstandings","Mentor"],"additional_data":{},"cover_img":""},{"idx":172375,"main_group":39,"sort_no":9,"p_sort_no":0,"subtitle":[],"description":[],"link_url":"/novel/3899","novel_no":3899,"flag_cate":16,"flag_content":1,"content_type":2,"novel_name":"Black Regalia","writer_name":"FriedGalacticChicken","novel_story":"Arx Revellion—the cold, enigmatic heir of the Revellion bloodline has earned a reputation as il Fantasma, a ghost among killers, a myth whispered even among monsters. Known by some as Lupo Solitario, his brutal precision and unpredictable nature have made him both feared and hunted. But Arx isn’t driven by power, titles, or legacy. He kills when he must. He follows orders only when they serve his own code.\n\nAt the heart of the rising chaos lies a long-lost relic: Rebellion, a black blade forged in secrecy and feared across generations. Unlike a Regalia, Rebellion is an Omerta Artifact—a weapon of the old world, bound by blood oaths and chaos itself. And now, it has chosen Arx as its wielder.\n\n","novel_img":"https://gn.novelpia.com/upload/novel/3899/6b55c3634f635a5932d4fed118e305d217693122523711012498382","flag_adult":0,"flag_complete":0,"count_epi":26,"count_view":653,"count_like":61,"count_good":11,"new_epi_num":26,"new_epi_open_dt":"2026-06-01 00:57:16","novel_open_dt":"2026-01-25 03:56:49","flag_live":0,"flag_detail_trans":0,"detail_trans_dt":null,"novel_tag_list":["European Ambience","Drama","Dark Fantasy","Hunter","Revenge","Vampire","Funny"],"additional_data":{},"cover_img":""},{"idx":172381,"main_group":39,"sort_no":15,"p_sort_no":0,"subtitle":[],"description":[],"link_url":"/novel/3869","novel_no":3869,"flag_cate":12,"flag_content":1,"content_type":2,"novel_name":"So What I'm A Lazy Lightning Mage","writer_name":"Pkkachu","novel_story":"I used to be a guy named Keiko.\nA hunter wannabe. A total dud. Zero powers in a world where having none is basically a crime.\n\nOne night, while doomscrolling the Hunter’s Forum, I saw a veteran hunter whining about how everyone else was “wasting their potential.” Naturally, I told him to shut up in a very normal, very reasonable 5,700-word rant.\n\nHis reply?\n\n“Bet.”\n\nNext thing I know, I’m dropped into an actual dungeon with monsters, traps, and no refund policy. \n\nStarting from 14/04/26 Update Schedule is 2 times a week MON/FRI and sometimes inbetween","novel_img":"https://gn.novelpia.com/upload/novel/3869/1a0c7fcb691b2de4e5b0a5486512d7b417762523892991384589807","flag_adult":0,"flag_complete":0,"count_epi":37,"count_view":22278,"count_like":712,"count_good":360,"new_epi_num":36,"new_epi_open_dt":"2026-05-06 00:57:12","novel_open_dt":"2026-01-21 15:51:42","flag_live":0,"flag_detail_trans":0,"detail_trans_dt":null,"novel_tag_list":["Gender Bender","Comedy","Hunter","Tower Climbing","Social Media","Dungeons"],"additional_data":{},"cover_img":""},{"idx":172367,"main_group":39,"sort_no":1,"p_sort_no":0,"subtitle":[],"description":[],"link_url":"/novel/3661","novel_no":3661,"flag_cate":6,"flag_content":1,"content_type":2,"novel_name":"I Transmigrated as the Female Main Character’s Younger Brother in an Abusive Yuri Novel","writer_name":"NightOracle","novel_story":"When Ethan Moore wakes up, he realizes the world around him is the exact same one from a tragic yuri novel he read in his previous life.\n\nEven worse, one of the original female leads is now his older sister.\n\nThe other lead is Clara Vaughn.\n\nA woman so notoriously ruthless that even a stray dog would think twice before crossing her.\n\n“Lena, listen to me,” Ethan warns his sister over milk tea.\n“You need to stay far away from Clara Vaughn.”\n\nWhat he doesn’t realize is that the very woman he’s talking about is sitting right behind him.\n\n","novel_img":"https://gn.novelpia.com/upload/novel/3661/18ad861d3c1abe7318c70d2935fb551e1780041526261703715045","flag_adult":0,"flag_complete":0,"count_epi":195,"count_view":115782,"count_like":1090,"count_good":286,"new_epi_num":195,"new_epi_open_dt":"2026-06-08 00:00:00","novel_open_dt":"2025-12-31 05:12:40","flag_live":0,"flag_detail_trans":0,"detail_trans_dt":null,"novel_tag_list":["Light Novel","Pure Love","Transmigration","Male Protagonist","Slice of Life","Comedy","Misunderstandings","Age Gap","Single Female Lead"],"additional_data":{},"cover_img":""},{"idx":172376,"main_group":39,"sort_no":10,"p_sort_no":0,"subtitle":[],"description":[],"link_url":"/novel/4341","novel_no":4341,"flag_cate":16,"flag_content":1,"content_type":2,"novel_name":"Nightblade Academy","writer_name":"AstorPendragon","novel_story":"Nightblade Academy is the most prestigious academy dedicated to cultivating the finest assassins, gunmen, mercenaries, and military officers in the world. Sieg Brenner is the new and mysterious transfer student, the disciple of a legendary assassin. He immediately gets the attention of Yumi Hasegawa, the Scarlet Queen and the top-ranking student in the Academy, during his first day of school. Will he survive on his own? Or will he become another one of the Scarlet Queen's broken toys?","novel_img":"https://gn.novelpia.com/upload/novel/4341/6ee1050dc5a00bd0221d480ae1a2302817738433384381505379286","flag_adult":0,"flag_complete":0,"count_epi":63,"count_view":3636,"count_like":283,"count_good":59,"new_epi_num":63,"new_epi_open_dt":"2026-06-05 03:00:00","novel_open_dt":"2026-03-11 07:02:38","flag_live":0,"flag_detail_trans":0,"detail_trans_dt":null,"novel_tag_list":["Harem","Light Novel","Academy","Romantic Comedy","Overpowered","Character Growth","Yandere","Obsession","Adventure"],"additional_data":{},"cover_img":""},{"idx":172373,"main_group":39,"sort_no":7,"p_sort_no":0,"subtitle":[],"description":[],"link_url":"/novel/3402","novel_no":3402,"flag_cate":1,"flag_content":1,"content_type":2,"novel_name":"I chased the Stalker to an Another World because I wasn't done beating him up","writer_name":"VChicken404","novel_story":"I died fighting the stalker who targeted my little sister… only to wake up inside her favorite romance game.\n\nBut the bastard reincarnated too, as the heroine’s beloved main love interest, blessed by the world.\n\nAnd me? \n\nI am Lucien Crowley, the villainess’s secret boyfriend, destined for a tragic death to make his route shine.\n\nBut I refuse to die for his story.\n\nIf this world wants to protect him and bury me, then I will break its script, save the villainess… and take my revenge on the monster hiding behind the protagonist’s smile.","novel_img":"https://gn.novelpia.com/upload/novel/3402/1fdf6b7e03cda0a0a2b5fd10e00eb5081779889625611485326784","flag_adult":0,"flag_complete":0,"count_epi":161,"count_view":29026,"count_like":483,"count_good":468,"new_epi_num":160,"new_epi_open_dt":"2026-05-27 18:31:01","novel_open_dt":"2025-12-04 08:49:21","flag_live":0,"flag_detail_trans":0,"detail_trans_dt":null,"novel_tag_list":["Light Novel","Slice of Life","Academy","Misunderstandings","Comedy","Revenge","Obsession","Reincarnation","Villainess"],"additional_data":{},"cover_img":""},{"idx":172368,"main_group":39,"sort_no":2,"p_sort_no":0,"subtitle":[],"description":[],"link_url":"/novel/4723","novel_no":4723,"flag_cate":3,"flag_content":1,"content_type":2,"novel_name":"After Transmigrating as a Side Character, I Just Want a Quiet Life","writer_name":"NightOracle","novel_story":"After dying from overwork, Reed Hale wakes up inside a romance game as a disposable side character whose name sounds almost exactly like his own.\n\nThere is only one problem: in the original story, that character ruins his life over a girl and ends up in prison.\n\nReed wants none of it. He just wants to shake off the original host’s lingering obsession, find a strong backer, make some money, 